# auto-instrumentation 빌드 대상 에이전트 버전 선언
#
# 이 파일이 dev 자동빌드의 "버전 소스(source of truth)"다.
# proto 브랜치에 이 파일이 커밋/푸시되면 watcher(watch-auto-instrumentation.sh)가
# 변경된 언어를 감지해 해당 버전으로 dev 이미지를 자동 빌드한다.
#   → docker.io/whatap/dev_apm-init-<lang>:<ver>-dev
#
# 버전을 올리려면 아래 값을 바꿔 proto 에 커밋/푸시하면 된다(= 빌드 트리거).
# 에이전트 버전 출처:
#   - java   : repo.whatap.io maven (whatap.agent)
#   - python : PyPI whatap-python
#   - nodejs : npm whatap (dist-tags.latest)
#
# 형식: <LANG>_AGENT_VERSION=<x.y.z>  (주석/빈 줄 허용, 공백 없는 KEY=VALUE)

JAVA_AGENT_VERSION=2.2.61
PYTHON_AGENT_VERSION=1.8.10
NODEJS_AGENT_VERSION=2.0.2
