# auto-instrumentation dev 자동빌드 — 수동 핀/제외 (선택)
#
# 기본 동작: 이 파일에 값이 없으면(또는 파일이 없으면) watcher가 공식 소스에서
# 최신 published 버전을 자동 추종해 dev 이미지를 빌드한다.
#   - java   : 릴리스노트 docs.whatap.io/release-notes/java
#   - python : PyPI whatap-python
#   - nodejs : npm whatap (dist-tags.latest)
#
# 오버라이드(언어별, 선택):
#   <LANG>_AGENT_VERSION=skip     → 그 언어 자동빌드를 끈다.
#   <LANG>_AGENT_VERSION=x.y.z    → 그 버전으로 고정(최신 무시). state와 다르면 1회 빌드.
#   (값을 비우거나 줄을 지우면 → 최신 자동 추종, 기본 동작)
#
# 예) java 만 2.2.70 으로 고정하고 python 은 자동 끄기:
#   JAVA_AGENT_VERSION=2.2.70
#   PYTHON_AGENT_VERSION=skip
#   NODEJS_AGENT_VERSION=

JAVA_AGENT_VERSION=
PYTHON_AGENT_VERSION=
NODEJS_AGENT_VERSION=
